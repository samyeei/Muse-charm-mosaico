index 0000000..3302fa3
--- /dev/null
+++ b/ESP-Iris/components/esp_iris/tools/tests/test_windows_usb.py
@@ -0,0 +1,30 @@
+"""Windows descriptor role mapping; no serial ports are opened."""
+from types import SimpleNamespace
+
+import pytest
+
+from iris_gateway import discovery, usb_descriptors
+
+
+@pytest.mark.parametrize("locations", [("1-8:x.0", "1-8:x.2"), ("2-1:1.0", "2-1:1.2")])
+def test_windows_dual_cdc_roles(monkeypatch, locations):
+    ports = [SimpleNamespace(device=f"COM{i + 3}", vid=0x303A, pid=0x4002,
+                             serial_number="same", location=location, interface=None, product=None)
+             for i, location in enumerate(locations)]
+    monkeypatch.setattr(usb_descriptors.sys, "platform", "win32")
+    monkeypatch.setattr(usb_descriptors.list_ports, "comports", lambda: ports)
+    devices = discovery.discover_iris_usb_devices()
+    assert [device.link_role for device in devices] == ["control", "data"]
+    assert discovery.resolve_usb_port("COM4")["link_role"] == "data"
+    assert ports[1].interface is None
+
+
+@pytest.mark.parametrize("location", [None, "1-8", "1-8:x.4"])
+def test_unknown_interface_is_not_guessed(location):
+    port = SimpleNamespace(vid=0x303A, pid=0x4002, location=location)
+    assert usb_descriptors._windows_port(port).iris_link_role == "unknown"
+
+
+def test_other_usb_products_unchanged():
+    port = SimpleNamespace(vid=0x303A, pid=0x20)
+    assert usb_descriptors._windows_port(port) is port
