index 0000000..a19a2d9
--- /dev/null
+++ b/esp-mosaico-vibe-mode/firmware/vibe-mode/components/app_character/include/factory_character_guard.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <stdbool.h>
+#include "esp_err.h"
+/* Startup task only, before iris_bridge_resume_boot. When enabled, restores
+ * interrupted transactions through the exclusive system-update writer before
+ * allowing automatic boot. False keeps Recovery running. Candidate admission
+ * remains closed; only a protected local initial restore may be installed.
+ * start_transport runs after writer reservation and before any restart call;
+ * providers must already be registered. It must start Iris or fail fatally. */
+bool factory_character_allow_automatic_boot(void (*start_transport)(void));
+/* Trusted USB maintenance only: cancel a task that has not started NOR writes.
+ * Corrupt journals / WRITING / TRIAL / RESTORING remain blocked. No erase,
+ * formatting, journal deletion, reboot or unconditional writer takeover. */
+esp_err_t factory_character_cancel_unwritten(void);
+/* Queued USB retry of a readable transaction; corrupt records remain blocked.
+ * Worker owns maintenance/NOR reservation until it completes or restarts. */
+esp_err_t factory_character_repair_start(void);
+/* Explicit USB repair of unreadable history from the verified protected initial
+ * backup. Preserves damaged history and never creates/formats a backup. */
+esp_err_t factory_character_journal_repair_start(void);
+enum { FACTORY_CHARACTER_REPAIR_IDLE, FACTORY_CHARACTER_REPAIR_RUNNING,
+       FACTORY_CHARACTER_REPAIR_FAILED };
+void factory_character_repair_status(unsigned *state, esp_err_t *error);
diff --git a/esp-mosaico-vibe-mode/firmware/vibe-mode/components/app_character/include/factory_character_io.h b/esp-mosaico-vibe-mode/firmware/vibe-mode/components/app_character/include/factory_character_io.h
