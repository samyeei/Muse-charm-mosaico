+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "mosaico_character_transaction.h"
+
+enum { BYTES=192, CHUNK=64, CUT_EXIT=73 };
+static int cut_at, sync_count, write_calls;
+static mosaico_character_journal_store_handle_t store;
+static void point(int n) { if (cut_at==n) _Exit(CUT_EXIT); }
+esp_err_t mosaico_nand_store_sync(void) { point(++sync_count); return ESP_OK; }
+static void read_all(const char *name, unsigned char *data)
+{
+    FILE *f=fopen(name,"rb"); assert(f);
+    assert(fread(data,1,BYTES,f)==BYTES); assert(fgetc(f)==EOF); assert(!fclose(f));
+}
+static void put_all(const char *name,const unsigned char *data)
+{
+    FILE *f=fopen(name,"wb"); assert(f);
+    assert(fwrite(data,1,BYTES,f)==BYTES); assert(!fclose(f));
+}
+static esp_err_t candidate(void *ctx,const mosaico_character_record_t *r)
+{ (void)ctx;(void)r;return ESP_OK; }
+static esp_err_t backup(void *ctx,unsigned char hash[32])
+{
+    (void)ctx;unsigned char data[BYTES];read_all("active.bin",data);
+    put_all("backup.bin",data);memset(hash,0,32);hash[0]=8;return ESP_OK;
+}
+static esp_err_t verify(void *ctx,const mosaico_character_record_t *r)
+{
+    (void)ctx;unsigned char data[BYTES];read_all("backup.bin",data);
+    if(r->backup_sha256[0]!=8)return ESP_FAIL;
+    for(int i=0;i<BYTES;++i)if(data[i]!=0x11)return ESP_FAIL;
+    return ESP_OK;
+}
+static esp_err_t write_chunks(const mosaico_character_record_t *r,int old)
+{
+    ++write_calls;
+    mosaico_character_record_t disk;
+    assert(mosaico_character_journal_store_load(store,&disk)==ESP_OK);
+    assert(disk.phase==(old?MOSAICO_CHARACTER_RESTORING:MOSAICO_CHARACTER_WRITING));
+    assert(disk.sequence==r->sequence);
+    unsigned char data[BYTES];
+    if(old)read_all("backup.bin",data);else memset(data,0x99,sizeof(data));
+    FILE *f=fopen("active.bin","r+b");assert(f);
+    for(int n=0;n<3;++n){
+        assert(fwrite(data+n*CHUNK,1,CHUNK,f)==CHUNK);assert(!fflush(f));
+        point((old?201:101)+n);
+    }
+    assert(!fclose(f));return ESP_OK;
+}
+static esp_err_t new_write(void *ctx,const mosaico_character_record_t *r)
+{(void)ctx;return write_chunks(r,0);}
+static esp_err_t old_write(void *ctx,const mosaico_character_record_t *r)
+{(void)ctx;return write_chunks(r,1);}
+static mosaico_character_transaction_result_t run(int admitted)
+{
+    mosaico_character_transaction_ops_t ops={.verify_candidate=candidate,.backup=backup,
+        .verify_backup=verify,.write_candidate=new_write,.restore_backup=old_write};
+    mosaico_character_transaction_result_t result;
+    assert(mosaico_character_transaction_run(store,&ops,admitted,"cut-test",
+        0xd00000,0x300000,&result)==ESP_OK);
+    return result;
+}
+int main(int argc,char **argv)
+{
+    assert(argc==3);cut_at=atoi(argv[2]);
+    assert(mosaico_character_journal_store_create("journal",&store)==ESP_OK);
+    if(!strcmp(argv[1],"setup")){
+        unsigned char data[BYTES];memset(data,0x11,sizeof(data));put_all("active.bin",data);
+        mosaico_character_record_t r={.sequence=1,.phase=MOSAICO_CHARACTER_STAGED,
+            .partition_address=0xd00000,.partition_bytes=0x300000,.image_bytes=96};
+        strcpy(r.job,"cut-job");strcpy(r.compat_version,"cut-test");
+        strcpy(r.character_version,"new");r.image_sha256[0]=1;
+        assert(mosaico_character_journal_store_save(store,&r)==ESP_OK);
+    }else if(!strcmp(argv[1],"install")){
+        assert(run(1)==MOSAICO_CHARACTER_RESULT_TRIAL);
+    }else if(!strcmp(argv[1],"restore")){
+        assert(run(0)==MOSAICO_CHARACTER_RESULT_NORMAL);
+    }else{
+        /* Pre-write cuts may retry installation, while WRITING/TRIAL cuts
+         * restore immediately. Never acknowledge a new role in this harness. */
+        if(run(1)==MOSAICO_CHARACTER_RESULT_TRIAL)
+            assert(run(0)==MOSAICO_CHARACTER_RESULT_NORMAL);
+        unsigned char data[BYTES];read_all("active.bin",data);
+        for(int i=0;i<BYTES;++i)assert(data[i]==0x11);
+        read_all("backup.bin",data);
+        for(int i=0;i<BYTES;++i)assert(data[i]==0x11);
+        mosaico_character_record_t r;
+        assert(mosaico_character_journal_store_load(store,&r)==ESP_OK);
+        assert(r.phase==MOSAICO_CHARACTER_ROLLED_BACK);
+        int previous_writes=write_calls;
+        assert(run(0)==MOSAICO_CHARACTER_RESULT_NORMAL);
+        assert(write_calls==previous_writes);
+    }
+    mosaico_character_journal_store_delete(store);return 0;
+}
+''', encoding="utf-8")
+    executable = tmp_path / "process-cut.exe"
+    subprocess.run([compiler, "-std=c11", "-D_POSIX_C_SOURCE=200809L", "-Wall", "-Wextra", "-Werror",
+                    "-I", str(tmp_path), "-I", str(component / "include"), str(source),
+                    str(component / "character_journal.c"), str(component / "character_journal_store.c"),
+                    str(component / "character_transaction.c"), "-o", str(executable)],
+                   check=True, capture_output=True, text=True)
+    for operation, points in (("install", [1, 2, 3, 4, 5, 6, 101, 102, 103]),
+                              ("restore", [1, 2, 3, 4, 201, 202, 203])):
+        for point in points:
+            case = tmp_path / f"{operation}-{point}"
+            case.mkdir()
+            subprocess.run([str(executable), "setup", "0"], cwd=case, check=True)
+            if operation == "restore":
+                subprocess.run([str(executable), "install", "0"], cwd=case, check=True)
+            interrupted = subprocess.run([str(executable), operation, str(point)], cwd=case)
+            assert interrupted.returncode == 73, (operation, point, interrupted.returncode)
+            # A fresh process reloads the durable journal; no runtime state survives.
+            subprocess.run([str(executable), "recover", "0"], cwd=case, check=True)
