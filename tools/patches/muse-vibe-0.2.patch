diff --git a/esp-mosaico-vibe-mode/components/esp_mosaico_nand_store/include/mosaico_nand_store.h b/esp-mosaico-vibe-mode/components/esp_mosaico_nand_store/include/mosaico_nand_store.h
new file mode 100644
index 0000000..5f98207
--- /dev/null
+++ b/esp-mosaico-vibe-mode/components/esp_mosaico_nand_store/include/mosaico_nand_store.h
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include "esp_err.h"
+
+#define MOSAICO_NAND_MOUNT_PATH "/nand"
+/* App-lifetime singleton owns SPI3, blockdev and LittleFS. Mount from the
+ * startup task before handing files to workers. Never formats existing media.
+ * All file IO then uses VFS; update-task file ownership is separate from mount. */
+esp_err_t mosaico_nand_store_mount(void);
+/* Destructive, explicit provisioning only: replace the old NAND filesystem
+ * with empty LittleFS and mount it. Rejects mounted/open diagnostic handles.
+ * Caller must hold exclusive ownership and obtain data-loss authorization.
+ * This is filesystem initialization, not forensic secure erasure. */
+esp_err_t mosaico_nand_store_initialize_empty(void);
+/* Diagnostic-only raw reads, no FTL mount or ECC refresh writes. Does not
+ * enable the filesystem. Call instead of mount when preserving unknown data. */
+esp_err_t mosaico_nand_store_probe_readonly(void);
+/* FTL inspection with raw write/erase/mutating-ioctl guards underneath. */
+esp_err_t mosaico_nand_store_probe_logical_readonly(void);
+/* Diagnostic RPC owner serializes calls. Raw export includes data pages only,
+ * not OOB/bad-block metadata, and is not an independently restorable image. */
+esp_err_t mosaico_nand_store_readonly_read(bool raw, uint64_t address, void *buffer, size_t bytes);
+/* One byte per physical erase block: 0 good, 1 bad. Diagnostic RPC owner
+ * serializes calls; reads chip markers through the guarded raw ioctl only. */
+esp_err_t mosaico_nand_store_readonly_bad_blocks(uint32_t first, uint8_t *buffer, size_t count);
+/* Startup-task diagnostic stage. Stable string, valid for the app lifetime. */
+const char *mosaico_nand_store_mount_stage(void);
+typedef struct {
+    uint64_t logical_bytes;
+    uint32_t page_bytes;
+    esp_err_t sample_result[2];
+    uint32_t sample_non_ff[2];
+    uint32_t sample_zero[2];
+    uint32_t raw_blocks_checked, raw_blocks_non_ff, raw_blocks_read_errors;
+    uint8_t raw;
+    uint8_t sample_format[2]; /* 0 unknown, 1 littlefs, 2 FAT16, 3 FAT32, 4 exFAT, 5 MBR */
+    char sample_prefix_hex[2][129]; /* First 64 bytes, local diagnostic only. */
+    uint32_t denied_writes;
+    char filesystem_error[192];
+} mosaico_nand_diagnostics_t;
+/* Samples are fixed after startup; denied_writes can change under the serialized
+ * diagnostic RPC owner. Samples are read-only metadata pages,
+ * and erased samples do not establish that the entire NAND is empty. */
+const mosaico_nand_diagnostics_t *mosaico_nand_store_diagnostics(void);
+esp_err_t mosaico_nand_store_usage(size_t *total, size_t *used);
+/* Flush the wear-leveling journal after VFS fsync/rename, before reboot. */
+esp_err_t mosaico_nand_store_sync(void);
diff --git a/esp-mosaico-vibe-mode/components/esp_mosaico_nand_store/nand_fs_geometry.c b/esp-mosaico-vibe-mode/components/esp_mosaico_nand_store/nand_fs_geometry.c
new file mode 100644
index 0000000..0d37004
--- /dev/null
+++ b/esp-mosaico-vibe-mode/components/esp_mosaico_nand_store/nand_fs_geometry.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "nand_fs_geometry.h"
+#include "littlefs/lfs.h"
+#include "sdkconfig.h"
+#include <stdlib.h>
+
+static int probe_read(const struct lfs_config *cfg, lfs_block_t block,
+    lfs_off_t off, void *data, lfs_size_t bytes)
+{
+    esp_blockdev_handle_t dev = cfg->context;
+    uint64_t address = (uint64_t)block * cfg->block_size + off;
+    if (address > dev->geometry.disk_size || bytes > dev->geometry.disk_size - address)
+        return LFS_ERR_IO;
+    return dev->ops->read(dev, data, bytes, address, bytes) == ESP_OK ? 0 : LFS_ERR_IO;
+}
+static int deny_prog(const struct lfs_config *cfg, lfs_block_t block,
+    lfs_off_t off, const void *data, lfs_size_t bytes)
+{ (void)cfg; (void)block; (void)off; (void)data; (void)bytes; return LFS_ERR_IO; }
+static int deny_erase(const struct lfs_config *cfg, lfs_block_t block)
+{ (void)cfg; (void)block; return LFS_ERR_IO; }
+static int probe_sync(const struct lfs_config *cfg)
+{ (void)cfg; return 0; }
+
+esp_err_t mosaico_nand_fs_geometry_pin(esp_blockdev_handle_t dev)
+{
+    if (!dev || !dev->ops || !dev->ops->read || !dev->geometry.erase_size)
+        return ESP_ERR_INVALID_ARG;
+    /* The probe uses upstream LittleFS's supported block_count=0 auto-detect.
+     * It cannot format, grow, erase or program the medium. The configured
+     * driver bounds every read even before the superblock is validated. */
+    lfs_t *fs = calloc(1, sizeof(*fs));
+    struct lfs_config *cfg = calloc(1, sizeof(*cfg));
+    if (!fs || !cfg) { free(fs); free(cfg); return ESP_ERR_NO_MEM; }
+    cfg->context = dev; cfg->read = probe_read; cfg->prog = deny_prog;
+    cfg->erase = deny_erase; cfg->sync = probe_sync;
+    cfg->read_size = dev->geometry.read_size;
+    cfg->prog_size = dev->geometry.write_size;
+    cfg->block_size = dev->geometry.erase_size;
+    cfg->cache_size = cfg->block_size < CONFIG_LITTLEFS_CACHE_SIZE ?
+        cfg->block_size : CONFIG_LITTLEFS_CACHE_SIZE;
+    cfg->lookahead_size = CONFIG_LITTLEFS_LOOKAHEAD_SIZE;
+    cfg->block_cycles = CONFIG_LITTLEFS_BLOCK_CYCLES;
+    int res = lfs_mount(fs, cfg);
+    esp_err_t err = ESP_FAIL;
+    if (res == 0) {
+        uint64_t stored = (uint64_t)fs->block_count * cfg->block_size;
+        if (stored && stored <= dev->geometry.disk_size) {
+            dev->geometry.disk_size = stored;
+            err = ESP_OK;
+        } else err = ESP_ERR_INVALID_SIZE;
+        if (lfs_unmount(fs) != 0) err = ESP_FAIL;
+    }
+    free(cfg); free(fs);
+    return err;
+}
diff --git a/esp-mosaico-vibe-mode/components/esp_mosaico_nand_store/nand_fs_geometry.h b/esp-mosaico-vibe-mode/components/esp_mosaico_nand_store/nand_fs_geometry.h
new file mode 100644
index 0000000..bf11c49
--- /dev/null
+++ b/esp-mosaico-vibe-mode/components/esp_mosaico_nand_store/nand_fs_geometry.h
@@ -0,0 +1,8 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "esp_blockdev.h"
+#include "esp_err.h"
+/* Read-only mount probe: retain the validated on-disk filesystem extent.
+ * A Dhara capacity estimate can change across checkpoints; it is not a
+ * filesystem resize request. Reject media smaller than the stored extent. */
+esp_err_t mosaico_nand_fs_geometry_pin(esp_blockdev_handle_t dev);
diff --git a/esp-mosaico-vibe-mode/components/esp_mosaico_nand_store/nand_store.c b/esp-mosaico-vibe-mode/components/esp_mosaico_nand_store/nand_store.c
new file mode 100644
index 0000000..36420c9
--- /dev/null
+++ b/esp-mosaico-vibe-mode/components/esp_mosaico_nand_store/nand_store.c
@@ -0,0 +1,396 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "mosaico_nand_store.h"
+#include "nand_fs_geometry.h"
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdatomic.h>
+#include "bsp/esp_mosaico.h"
+#include "driver/gpio.h"
+#include "driver/spi_master.h"
+#include "esp_blockdev.h"
+#include "esp_littlefs.h"
+#include "esp_log.h"
+#include "spi_nand_flash.h"
+#include "esp_nand_blockdev.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+enum { TRANSFER_BYTES = 4096, DEFAULT_GC_FACTOR = 45 };
+_Static_assert(CONFIG_LITTLEFS_CACHE_SIZE >= 2048,
+               "onboard NAND requires CONFIG_LITTLEFS_CACHE_SIZE >= 2048");
+static const char *TAG = "mosaico_nand";
+static const char *mount_stage = "not_started";
+static mosaico_nand_diagnostics_t diagnostics = {
+    .sample_result = {ESP_ERR_INVALID_STATE, ESP_ERR_INVALID_STATE},
+};
+static struct {
+    esp_blockdev_handle_t blockdev;
+    esp_blockdev_handle_t raw_blockdev; /* Borrowed; logical release owns it. */
+    spi_device_handle_t spi;
+    bool bus_initialized;
+    bool mounted;
+    bool diagnostic_readonly;
+    uint8_t *diagnostic_page;
+    uint64_t cached_address;
+    bool cache_valid;
+    bool cached_raw;
+} store;
+static esp_blockdev_ops_t readonly_ops;
+static const esp_blockdev_ops_t *raw_ops;
+
+static esp_err_t deny_write(esp_blockdev_handle_t handle, const uint8_t *data, uint64_t address, size_t bytes)
+{
+    (void)handle; (void)data; (void)address; (void)bytes;
+    ++diagnostics.denied_writes;
+    return ESP_ERR_NOT_ALLOWED;
+}
+
+static esp_err_t deny_erase(esp_blockdev_handle_t handle, uint64_t address, size_t bytes)
+{
+    (void)handle; (void)address; (void)bytes;
+    ++diagnostics.denied_writes;
+    return ESP_ERR_NOT_ALLOWED;
+}
+
+static esp_err_t readonly_ioctl(esp_blockdev_handle_t handle, const uint8_t command, void *args)
+{
+    switch (command) {
+    case ESP_BLOCKDEV_CMD_IS_BAD_BLOCK:
+    case ESP_BLOCKDEV_CMD_IS_FREE_PAGE:
+    case ESP_BLOCKDEV_CMD_GET_PAGE_ECC_STATUS:
+    case ESP_BLOCKDEV_CMD_GET_NAND_FLASH_INFO:
+        return raw_ops->ioctl(handle, command, args);
+    default:
+        ++diagnostics.denied_writes;
+        return ESP_ERR_NOT_ALLOWED;
+    }
+}
+
+static uint8_t classify_page(const uint8_t *page, size_t bytes)
+{
+    for (size_t index = 0; index + 8 <= bytes; ++index)
+        if (memcmp(page + index, "littlefs", 8) == 0) return 1;
+    if (bytes >= 512) {
+        if (memcmp(page + 3, "EXFAT   ", 8) == 0) return 4;
+        if (memcmp(page + 82, "FAT32   ", 8) == 0) return 3;
+        if (memcmp(page + 54, "FAT16   ", 8) == 0) return 2;
+        if (page[510] == 0x55 && page[511] == 0xaa) return 5;
+    }
+    return 0;
+}
+/* Temporarily retain mount errors before the boot log ring overwrites them.
+ * Only the startup owner copies text; other tasks forward unchanged. The
+ * original logger is restored immediately after filesystem registration. */
+static _Atomic(vprintf_like_t) upstream_logger = vprintf;
+static _Atomic(TaskHandle_t) diagnostic_owner;
+static char *diagnostic_scratch;
+
+static int mount_log(const char *format, va_list args)
+{
+    if (xTaskGetCurrentTaskHandle() == atomic_load(&diagnostic_owner) && diagnostic_scratch != NULL) {
+        va_list copy;
+        va_copy(copy, args);
+        vsnprintf(diagnostic_scratch, 512, format, copy);
+        va_end(copy);
+        if (strstr(diagnostic_scratch, "mount failed,") != NULL ||
+            strstr(diagnostic_scratch, "Corrupted dir pair") != NULL ||
+            strstr(diagnostic_scratch, "Failed to read the page") != NULL) {
+            snprintf(diagnostics.filesystem_error, sizeof(diagnostics.filesystem_error),
+                     "%.*s", (int)sizeof(diagnostics.filesystem_error) - 1, diagnostic_scratch);
+        }
+    }
+    return atomic_load(&upstream_logger)(format, args);
+}
+
+static void sample_metadata(void)
+{
+    diagnostics.logical_bytes = store.blockdev->geometry.disk_size;
+    diagnostics.page_bytes = store.blockdev->geometry.read_size;
+    const size_t bytes = diagnostics.page_bytes;
+    if (bytes == 0 || bytes > TRANSFER_BYTES || diagnostics.logical_bytes < bytes * 2U) return;
+    uint8_t *page = malloc(bytes);
+    if (page == NULL) {
+        diagnostics.sample_result[0] = diagnostics.sample_result[1] = ESP_ERR_NO_MEM;
+        return;
+    }
+    for (unsigned index = 0; index < 2; ++index) {
+        diagnostics.sample_result[index] = store.blockdev->ops->read(
+            store.blockdev, page, bytes, (uint64_t)index * bytes, bytes);
+        if (diagnostics.sample_result[index] == ESP_OK) {
+            for (size_t offset = 0; offset < bytes && offset < 64; ++offset)
+                snprintf(diagnostics.sample_prefix_hex[index] + offset * 2, 3, "%02x", page[offset]);
+            diagnostics.sample_format[index] = classify_page(page, bytes);
+            for (size_t offset = 0; offset < bytes; ++offset)
+                diagnostics.sample_non_ff[index] += page[offset] != 0xff;
+            for (size_t offset = 0; offset < bytes; ++offset)
+                diagnostics.sample_zero[index] += page[offset] == 0;
+        }
+    }
+    free(page);
+}
+
+static void sample_raw_blocks(void)
+{
+    const size_t bytes = store.blockdev->geometry.read_size;
+    const uint32_t erase_bytes = store.blockdev->geometry.erase_size;
+    if (bytes == 0 || bytes > TRANSFER_BYTES || erase_bytes == 0) return;
+    uint8_t *page = malloc(bytes);
+    if (page == NULL) return;
+    /* One read-only page per physical erase block, not an empty-media proof.
+     * Raw BDL calls nand_read directly and never refreshes ECC pages. */
+    for (uint64_t address = 0; address < diagnostics.logical_bytes; address += erase_bytes) {
+        ++diagnostics.raw_blocks_checked;
+        esp_err_t err = store.blockdev->ops->read(store.blockdev, page, bytes, address, bytes);
+        if (err != ESP_OK) { ++diagnostics.raw_blocks_read_errors; continue; }
+        for (size_t index = 0; index < bytes; ++index) {
+            if (page[index] != 0xff) { ++diagnostics.raw_blocks_non_ff; break; }
+        }
+    }
+    free(page);
+}
+
+static esp_err_t release_pin(gpio_num_t pin)
+{
+    const gpio_config_t config = {
+        .pin_bit_mask = BIT64(pin), .mode = GPIO_MODE_OUTPUT,
+        .pull_up_en = GPIO_PULLUP_ENABLE, .pull_down_en = GPIO_PULLDOWN_DISABLE,
+        .intr_type = GPIO_INTR_DISABLE,
+    };
+    esp_err_t err = gpio_set_level(pin, 1);
+    if (err == ESP_OK) err = gpio_config(&config);
+    if (err == ESP_OK) err = gpio_set_level(pin, 1);
+    return err;
+}
+
+static void cleanup_partial(void)
+{
+    free(store.diagnostic_page);
+    store.diagnostic_page = NULL;
+    store.cache_valid = false;
+    store.diagnostic_readonly = false;
+    if (store.blockdev != NULL) {
+        (void)store.blockdev->ops->release(store.blockdev);
+        store.blockdev = NULL;
+        store.raw_blockdev = NULL;
+    }
+    if (store.spi != NULL) {
+        (void)spi_bus_remove_device(store.spi);
+        store.spi = NULL;
+    }
+    if (store.bus_initialized) {
+        (void)spi_bus_free(BSP_NAND_SPI_HOST);
+        store.bus_initialized = false;
+    }
+}
+
+/* 0 production mount, 1 raw inspection, 2 guarded logical inspection,
+ * 3 explicitly authorized filesystem initialization. Never selected at boot. */
+static esp_err_t initialize_store(unsigned mode)
+{
+    if (store.mounted) return ESP_OK;
+    if (store.blockdev != NULL) return ESP_ERR_INVALID_STATE;
+    memset(&diagnostics, 0, sizeof(diagnostics));
+    diagnostics.sample_result[0] = diagnostics.sample_result[1] = ESP_ERR_INVALID_STATE;
+    const bool raw_only = mode == 1;
+    const bool readonly = mode == 1 || mode == 2;
+    diagnostics.raw = raw_only;
+    mount_stage = "hold_pin";
+    esp_err_t err = release_pin(BSP_NAND_HOLD);
+    if (err == ESP_OK) {
+        mount_stage = "wp_pin";
+        err = release_pin(BSP_NAND_WP);
+    }
+    if (err != ESP_OK) return err;
+    const spi_bus_config_t bus = {
+        .mosi_io_num = BSP_NAND_D, .miso_io_num = BSP_NAND_Q,
+        .sclk_io_num = BSP_NAND_CLK, .quadhd_io_num = GPIO_NUM_NC,
+        .quadwp_io_num = GPIO_NUM_NC, .max_transfer_sz = TRANSFER_BYTES,
+    };
+    mount_stage = "spi_bus";
+    err = spi_bus_initialize(BSP_NAND_SPI_HOST, &bus, SPI_DMA_CH_AUTO);
+    if (err != ESP_OK) return err;
+    store.bus_initialized = true;
+    const spi_device_interface_config_t device = {
+        .clock_speed_hz = BSP_NAND_FLASH_DEFAULT_CLOCK_HZ,
+        .mode = 0, .spics_io_num = BSP_NAND_CS,
+        .queue_size = BSP_NAND_FLASH_DEFAULT_QUEUE_SIZE,
+        .flags = SPI_DEVICE_HALFDUPLEX,
+    };
+    mount_stage = "spi_device";
+    err = spi_bus_add_device(BSP_NAND_SPI_HOST, &device, &store.spi);
+    if (err != ESP_OK) goto fail;
+    spi_nand_flash_config_t config = {
+        .device_handle = store.spi, .gc_factor = DEFAULT_GC_FACTOR,
+        .io_mode = SPI_NAND_IO_MODE_SIO, .flags = SPI_DEVICE_HALFDUPLEX,
+    };
+    mount_stage = "nand_layers";
+    err = readonly ? nand_flash_get_blockdev(&config, &store.blockdev)
+                   : spi_nand_flash_init_with_layers(&config, &store.blockdev);
+    if (err != ESP_OK) goto fail;
+    if (readonly) {
+        store.blockdev->device_flags.read_only = 1;
+        raw_ops = store.blockdev->ops;
+        readonly_ops = *raw_ops;
+        readonly_ops.write = deny_write;
+        readonly_ops.erase = deny_erase;
+        readonly_ops.ioctl = readonly_ioctl;
+        store.blockdev->ops = &readonly_ops;
+        store.raw_blockdev = store.blockdev;
+    }
+    if (mode == 2) {
+        esp_blockdev_handle_t logical = NULL;
+        err = spi_nand_flash_wl_get_blockdev(store.blockdev, &logical);
+        if (err != ESP_OK) goto fail;
+        store.blockdev = logical;
+        store.blockdev->device_flags.read_only = 1;
+    }
+    sample_metadata();
+    if (readonly) {
+        mount_stage = raw_only ? "raw_readonly" : "logical_readonly";
+        if (raw_only) sample_raw_blocks();
+        if (mode == 2) {
+            store.diagnostic_page = malloc(store.blockdev->geometry.read_size);
+            if (store.diagnostic_page == NULL) { err = ESP_ERR_NO_MEM; goto fail; }
+            store.diagnostic_readonly = true;
+        }
+        else cleanup_partial();
+        return ESP_OK;
+    }
+    if (mode == 3) {
+        mount_stage = "explicit_format";
+        err = esp_littlefs_format_blockdev(store.blockdev);
+        if (err != ESP_OK) goto fail;
+        if (store.blockdev->ops->sync == NULL) { err = ESP_ERR_NOT_SUPPORTED; goto fail; }
+        err = store.blockdev->ops->sync(store.blockdev);
+        if (err != ESP_OK) goto fail;
+    }
+    mount_stage = "filesystem_geometry";
+    err = mosaico_nand_fs_geometry_pin(store.blockdev);
+    if (err != ESP_OK) goto fail;
+    const esp_vfs_littlefs_conf_t mount = {
+        .base_path = MOSAICO_NAND_MOUNT_PATH, .blockdev = store.blockdev,
+        .format_if_mount_failed = false, .read_only = false,
+        .dont_mount = false, .grow_on_mount = false,
+    };
+    mount_stage = "littlefs";
+    diagnostic_scratch = malloc(512);
+    vprintf_like_t previous_logger = NULL;
+    if (diagnostic_scratch != NULL) {
+        atomic_store(&diagnostic_owner, xTaskGetCurrentTaskHandle());
+        previous_logger = esp_log_set_vprintf(mount_log);
+        atomic_store(&upstream_logger, previous_logger);
+    }
+    err = esp_vfs_littlefs_register(&mount);
+    if (previous_logger != NULL) (void)esp_log_set_vprintf(previous_logger);
+    free(diagnostic_scratch);
+    diagnostic_scratch = NULL;
+    if (err != ESP_OK) {
+        /* LittleFS releases the blockdev on registration failure. */
+        store.blockdev = NULL;
+        goto fail;
+    }
+    store.mounted = true;
+    mount_stage = "usage";
+    size_t total = 0, used = 0;
+    err = mosaico_nand_store_usage(&total, &used);
+    if (err == ESP_OK) {
+        mount_stage = "mounted";
+        ESP_LOGI(TAG, "mounted%s: total=%u used=%u", mode == 3 ? " after explicit initialization" : " without formatting", (unsigned)total, (unsigned)used);
+    }
+    return err;
+fail:
+    cleanup_partial();
+    ESP_LOGE(TAG, "mount failed at %s (%s): %s", mount_stage,
+             mode == 3 ? "explicit initialization" : "no automatic formatting", esp_err_to_name(err));
+    return err;
+}
+
+const char *mosaico_nand_store_mount_stage(void)
+{
+    return mount_stage;
+}
+
+esp_err_t mosaico_nand_store_mount(void)
+{
+    return initialize_store(0);
+}
+
+esp_err_t mosaico_nand_store_initialize_empty(void)
+{
+    /* A healthy filesystem, open files or retained diagnostic handles must
+     * never be destroyed. Caller holds exclusive storage ownership and has
+     * obtained explicit authorization to discard the old NAND filesystem. */
+    if (store.mounted || store.blockdev != NULL) return ESP_ERR_INVALID_STATE;
+    return initialize_store(3);
+}
+
+esp_err_t mosaico_nand_store_probe_readonly(void)
+{
+    if (store.mounted) return ESP_ERR_INVALID_STATE;
+    return initialize_store(1);
+}
+
+esp_err_t mosaico_nand_store_probe_logical_readonly(void)
+{
+    if (store.mounted) return ESP_ERR_INVALID_STATE;
+    return initialize_store(2);
+}
+
+const mosaico_nand_diagnostics_t *mosaico_nand_store_diagnostics(void)
+{
+    return &diagnostics;
+}
+
+esp_err_t mosaico_nand_store_readonly_read(bool raw, uint64_t address, void *buffer, size_t bytes)
+{
+    if (!store.diagnostic_readonly || buffer == NULL || bytes == 0) return ESP_ERR_INVALID_STATE;
+    esp_blockdev_handle_t device = raw ? store.raw_blockdev : store.blockdev;
+    if (device == NULL || device->geometry.read_size == 0) return ESP_ERR_INVALID_STATE;
+    const size_t unit = device->geometry.read_size;
+    if (bytes > unit || address % unit + bytes > unit || address > device->geometry.disk_size ||
+        bytes > device->geometry.disk_size - address) return ESP_ERR_INVALID_SIZE;
+    const uint64_t page_address = address - address % unit;
+    if (!store.cache_valid || store.cached_address != page_address || store.cached_raw != raw) {
+        store.cache_valid = false;
+        esp_err_t err = device->ops->read(device, store.diagnostic_page, unit, page_address, unit);
+        if (err != ESP_OK) return err;
+        store.cached_address = page_address;
+        store.cached_raw = raw;
+        store.cache_valid = true;
+    }
+    memcpy(buffer, store.diagnostic_page + address % unit, bytes);
+    return ESP_OK;
+}
+
+esp_err_t mosaico_nand_store_readonly_bad_blocks(uint32_t first, uint8_t *buffer, size_t count)
+{
+    if (!store.diagnostic_readonly || store.raw_blockdev == NULL) return ESP_ERR_INVALID_STATE;
+    if (buffer == NULL || count == 0 || count > 128) return ESP_ERR_INVALID_ARG;
+    esp_blockdev_handle_t raw = store.raw_blockdev;
+    if (raw->geometry.erase_size == 0) return ESP_ERR_INVALID_STATE;
+    const uint64_t blocks = raw->geometry.disk_size / raw->geometry.erase_size;
+    if (first >= blocks || count > blocks - first) return ESP_ERR_INVALID_SIZE;
+    for (size_t index = 0; index < count; ++index) {
+        esp_blockdev_cmd_arg_is_bad_block_t marker = {(uint32_t)(first + index), false};
+        esp_err_t err = raw->ops->ioctl(raw, ESP_BLOCKDEV_CMD_IS_BAD_BLOCK, &marker);
+        if (err != ESP_OK) return err;
+        buffer[index] = marker.status ? 1 : 0;
+    }
+    return ESP_OK;
+}
+
+esp_err_t mosaico_nand_store_usage(size_t *total, size_t *used)
+{
+    if (total == NULL || used == NULL) return ESP_ERR_INVALID_ARG;
+    if (!store.mounted) return ESP_ERR_INVALID_STATE;
+    return esp_littlefs_blockdev_info(store.blockdev, total, used);
+}
+
+esp_err_t mosaico_nand_store_sync(void)
+{
+    if (!store.mounted || store.blockdev == NULL) return ESP_ERR_INVALID_STATE;
+    if (store.blockdev->ops->sync == NULL) return ESP_ERR_NOT_SUPPORTED;
+    return store.blockdev->ops->sync(store.blockdev);
+}
