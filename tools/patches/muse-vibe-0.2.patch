+# Private build policy for the consuming application and retained Recovery.
+set(MOSAICO_CHARACTER_INSTALL_COMPAT "" CACHE STRING "Admitted character interface, empty disables downloaded installs")
+set(MOSAICO_CHARACTER_INSTALL_JOB "" CACHE STRING "Optional exact character job for controlled validation")
+foreach(policy_var MOSAICO_CHARACTER_INSTALL_COMPAT MOSAICO_CHARACTER_INSTALL_JOB)
+    if(NOT "${${policy_var}}" STREQUAL "" AND NOT "${${policy_var}}" MATCHES "^[A-Za-z0-9_.-]+$")
+        message(FATAL_ERROR "Invalid character installation policy: ${policy_var}")
+    endif()
+endforeach()
+if(MOSAICO_CHARACTER_INSTALL_COMPAT)
+    target_compile_definitions(${COMPONENT_LIB} PRIVATE
+        "MOSAICO_CHARACTER_INSTALL_COMPAT=\"${MOSAICO_CHARACTER_INSTALL_COMPAT}\"")
+    if(MOSAICO_CHARACTER_INSTALL_JOB)
+        target_compile_definitions(${COMPONENT_LIB} PRIVATE
+            "MOSAICO_CHARACTER_INSTALL_JOB=\"${MOSAICO_CHARACTER_INSTALL_JOB}\"")
+    endif()
+elseif(MOSAICO_CHARACTER_INSTALL_JOB)
+    message(FATAL_ERROR "A character job restriction requires an admitted interface")
+endif()
