+"""Execute actual Vibe startup with a non-idempotent Iris service double."""
+from pathlib import Path
+import re
+import shutil
+import subprocess
+
+
+def test_startup_keeps_iris_available_without_duplicate_registration(tmp_path):
+    compiler = shutil.which('cc') or shutil.which('clang') or shutil.which('gcc')
+    assert compiler
+    root = Path(__file__).resolve().parents[1]
+    source = (root / 'firmware/vibe-mode/main/main.c').read_text(encoding='utf-8')
+    sdk = r'''
+#pragma once
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+typedef int esp_err_t;
+#define ESP_OK 0
+#define ESP_ERROR_CHECK(x) do {if ((x)!=0) abort();} while(0)
+#define ESP_ERROR_CHECK_WITHOUT_ABORT(x) ((void)(x))
+void host_log(const char *,const char *,...);
+#define ESP_LOGI(...) host_log(__VA_ARGS__)
+#define ESP_LOGW(...) host_log(__VA_ARGS__)
+#define ESP_LOGE(...) host_log(__VA_ARGS__)
+typedef struct {void *ctx; int (*open_download)(void *); int (*touch)(void *,int16_t,int16_t,bool);} app_iris_ui_t;
+int app_system_mute_audio(void),esp_iris_boot_probe(void),nvs_flash_init(void),factory_system_metadata_init(void);
+int vibe_settings_init(void),mosaico_boot_recovery_requested(bool *),mosaico_boot_consume_request(void);
+int iris_bridge_resume_boot(void),factory_system_inventory_register(void),factory_system_update_register(void);
+int factory_nand_update_init(void),app_iris_storage_register(void);
+int factory_recovery_control_register(const app_iris_ui_t *);
+int factory_ui_open_bridge(void *),factory_ui_inject_touch(void *,int16_t,int16_t,bool);
+void recovery_ota_support_start(void);
+bool factory_character_allow_automatic_boot(void (*)(void));
+int64_t esp_timer_get_time(void);
+const char *esp_err_to_name(int);
+int factory_ui_prepare(void),factory_network_start(void),factory_ui_start(void);
+unsigned uxTaskGetStackHighWaterMark(void *);
+void factory_ui_rotate(int),factory_ui_set_brightness(int);
+int vibe_device_start(void (*)(int),void (*)(int)),app_iris_input_register(const app_iris_ui_t *);
+int factory_ideas_init(void),esp_iris_mark_healthy(void);
+void app_system_log_boot_selection(bool,int);
+'''
+    (tmp_path / 'sdk.h').write_text(sdk)
+    for name in re.findall(r'#include "([^"]+)"', source):
+        p = tmp_path / name
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text('#include "sdk.h"\n')
+    harness = r'''
+#include "sdk.h"
+static int starts, resumes, healthy, mode;
+#define OK(name) int name(void){return 0;}
+OK(app_system_mute_audio) OK(esp_iris_boot_probe) OK(nvs_flash_init) OK(factory_system_metadata_init)
+OK(vibe_settings_init) OK(mosaico_boot_consume_request) OK(factory_system_inventory_register)
+OK(factory_system_update_register) OK(factory_nand_update_init) OK(app_iris_storage_register)
+OK(factory_ui_prepare) OK(factory_network_start) OK(factory_ideas_init)
+void host_log(const char *a,const char *b,...){(void)a;(void)b;}
+int mosaico_boot_recovery_requested(bool *v){*v=true;return 0;}
+int factory_ui_open_bridge(void *v){(void)v;return 0;}
+int factory_ui_inject_touch(void *v,int16_t x,int16_t y,bool p){(void)v;(void)x;(void)y;(void)p;return 0;}
+int factory_recovery_control_register(const app_iris_ui_t *v){assert(v->open_download && v->touch);return 0;}
+void recovery_ota_support_start(void){assert(++starts==1);}
+bool factory_character_allow_automatic_boot(void (*start)(void)){start();return mode!=1;}
+int iris_bridge_resume_boot(void){assert(starts==1);++resumes;return 0;}
+int64_t esp_timer_get_time(void){return 1;}
+const char *esp_err_to_name(int e){(void)e;return "error";}
+int factory_ui_start(void){assert(starts==1);return mode==2?-1:0;}
