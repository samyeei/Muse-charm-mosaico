+++ b/esp-mosaico-vibe-mode/firmware/vibe-mode/components/app_character/include/factory_character_io.h
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "mosaico_character_transaction.h"
+typedef struct factory_character_io_t *factory_character_io_handle_t;
+/* Read-only verification of protected full initial partition backup. Fills a
+ * reserved repair seed (caller supplies unique job before publication). */
+esp_err_t factory_character_io_prepare_repair(factory_character_io_handle_t handle,
+    mosaico_character_record_t *seed);
+/* Startup coordinator holds CHARACTER reservation before creation. Fixed
+ * product file names only; owns one transfer buffer and borrows live partition. */
+esp_err_t factory_character_io_create(const uint8_t operation_id[16],
+    factory_character_io_handle_t *out, mosaico_character_transaction_ops_t *ops);
+void factory_character_io_delete(factory_character_io_handle_t handle);
+/* Read-only full NOR hash against the old-image digest in the trusted record. */
+esp_err_t factory_character_io_verify_restored(factory_character_io_handle_t handle,
+    const mosaico_character_record_t *record);
+/* Read-only new NOR image hash before handing its durable TRIAL to the app. */
+esp_err_t factory_character_io_verify_trial(factory_character_io_handle_t handle,
+    const mosaico_character_record_t *record);
diff --git a/esp-mosaico-vibe-mode/firmware/vibe-mode/components/app_character/src/factory_character_guard.c b/esp-mosaico-vibe-mode/firmware/vibe-mode/components/app_character/src/factory_character_guard.c
new file mode 100644
index 0000000..87ebba2
--- /dev/null
+++ b/esp-mosaico-vibe-mode/firmware/vibe-mode/components/app_character/src/factory_character_guard.c
@@ -0,0 +1,309 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "factory_character_guard.h"
+#include "mosaico_character_journal_store.h"
+#include "mosaico_character_install_policy.h"
+#include "mosaico_nand_store.h"
+#include "esp_partition.h"
+#include "esp_log.h"
+#include "sdkconfig.h"
+#include "factory_character_io.h"
+#include "factory_system_update.h"
+#include "esp_random.h"
+#include "esp_ota_ops.h"
+#include "mosaico_boot.h"
+#include "esp_image_format.h"
+#include "esp_iris.h"
+#include "esp_system.h"
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdatomic.h>
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+static const char *TAG = "character_guard";
+/* Recovery-lifetime singleton. Startup owns it before RPC registration;
+ * subsequent maintenance calls are serialized by maintenance_busy. */
+static uint8_t held_operation[ESP_IRIS_SYSTEM_OPERATION_ID_BYTES];
+static bool writer_held;
+static atomic_flag maintenance_busy = ATOMIC_FLAG_INIT;
+static atomic_uint repair_state = ATOMIC_VAR_INIT(FACTORY_CHARACTER_REPAIR_IDLE);
+static atomic_int repair_error = ATOMIC_VAR_INIT(ESP_OK);
+/* Local initial restoration is independent of downloaded-image admission. */
+static const bool initial_restore_enabled = true;
+
+static esp_err_t return_to_trial(mosaico_character_journal_store_handle_t store,
+    factory_character_io_handle_t io, mosaico_character_record_t *record)
+{
+    esp_err_t err = mosaico_character_journal_store_load(store, record);
+    if (err == ESP_OK && record->phase != MOSAICO_CHARACTER_TRIAL) err = ESP_ERR_INVALID_STATE;
+    if (err == ESP_OK) err = factory_character_io_verify_trial(io, record);
+    const esp_partition_t *app = esp_partition_find_first(ESP_PARTITION_TYPE_APP,
+        ESP_PARTITION_SUBTYPE_APP_OTA_0, NULL);
+    if (err == ESP_OK && !app) err = ESP_ERR_NOT_FOUND;
+    esp_image_metadata_t *metadata = err == ESP_OK ? calloc(1, sizeof(*metadata)) : NULL;
+    if (err == ESP_OK && !metadata) err = ESP_ERR_NO_MEM;
+    if (err == ESP_OK) {
+        const esp_partition_pos_t position = {.offset = app->address, .size = app->size};
+        err = esp_image_verify(ESP_IMAGE_VERIFY, &position, metadata);
+    }
+    free(metadata);
+    if (err == ESP_OK) err = esp_iris_mark_planned_restart();
+    if (err == ESP_OK) err = mosaico_boot_select(app->address);
+    if (err == ESP_OK) err = factory_system_update_character_finish(held_operation);
+    if (err == ESP_OK) { writer_held = false; esp_restart(); }
+    else {
+        /* TRIAL remains durable. A subsequent Recovery boot restores the old
+         * resource instead of retrying an unaccepted new app indefinitely. */
+        const esp_partition_t *factory = esp_partition_find_first(ESP_PARTITION_TYPE_APP,
+            ESP_PARTITION_SUBTYPE_APP_TEST, NULL);
+        if (factory) ESP_ERROR_CHECK_WITHOUT_ABORT(mosaico_boot_request_recovery());
+    }
+    return err;
+}
+
+static esp_err_t return_to_application(mosaico_character_journal_store_handle_t store,
+    mosaico_character_record_t *record)
+{
+    factory_character_io_handle_t io = NULL;
+    mosaico_character_transaction_ops_t ops;
+    esp_err_t err = factory_character_io_create(held_operation, &io, &ops);
+    if (err == ESP_OK) err = factory_character_io_verify_restored(io, record);
+    factory_character_io_delete(io);
+    if (err != ESP_OK) return err;
+    const esp_partition_t *app = esp_partition_find_first(ESP_PARTITION_TYPE_APP,
+        ESP_PARTITION_SUBTYPE_APP_OTA_0, NULL);
+    if (!app) return ESP_ERR_NOT_FOUND;
+    esp_image_metadata_t *metadata = calloc(1, sizeof(*metadata));
+    if (!metadata) return ESP_ERR_NO_MEM;
+    const esp_partition_pos_t position = { .offset = app->address, .size = app->size };
+    err = esp_image_verify(ESP_IMAGE_VERIFY, &position, metadata);
+    free(metadata);
+    if (err != ESP_OK) return err;
+    err = esp_iris_mark_planned_restart();
+    if (err == ESP_OK) err = mosaico_boot_select(app->address);
+    /* Select the app before saving its trial handoff. A power cut here boots
+     * the app with ROLLED_BACK; the app completes the same handoff. */
+    if (err == ESP_OK) {
+        record->phase = MOSAICO_CHARACTER_ROLLBACK_TRIAL; record->sequence++;
+        err = mosaico_character_journal_store_save(store, record);
+    }
+    if (err == ESP_OK) err = factory_system_update_character_finish(held_operation);
+    if (err == ESP_OK) writer_held = false;
+    if (err == ESP_OK) {
+        ESP_LOGI(TAG, "Old resources verified and rollback durable; returning to application");
+        esp_restart();
+    }
+    if (err != ESP_OK) {
+        const esp_partition_t *factory = esp_partition_find_first(ESP_PARTITION_TYPE_APP,
+            ESP_PARTITION_SUBTYPE_APP_TEST, NULL);
+        if (factory) ESP_ERROR_CHECK_WITHOUT_ABORT(mosaico_boot_request_recovery());
+    }
+    return err;
+}
+bool factory_character_allow_automatic_boot(void (*start_transport)(void))
+{
+    if (!start_transport) return false;
+    /* Compiled on every build, enabled only when the complete transaction
+     * architecture is ready. The candidate package is never installable here. */
+#ifdef CONFIG_IRIS_FACTORY_CHARACTER_BOOT_GUARD
+    const bool enabled = true;
+#else
+    const bool enabled = false;
+#endif
+    if (!enabled) { start_transport(); return true; }
+    uint8_t *operation_id = held_operation;
+    esp_fill_random(operation_id, sizeof(held_operation));
+    if (factory_system_update_source_reserve(FACTORY_SYSTEM_UPDATE_OWNER_CHARACTER, operation_id) != ESP_OK) {
+        start_transport();
+        return false;
+    }
+    writer_held = true;
+    /* Planned restart requires started Iris. Reserve before exposing USB so
+     * host updates cannot acquire the writer during transaction startup. */
+    start_transport();
+    esp_err_t err = mosaico_nand_store_mount();
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "NAND unavailable; automatic boot held: %s", esp_err_to_name(err));
+        return false;
+    }
+    mosaico_character_journal_store_handle_t store = NULL;
+    err = mosaico_character_journal_store_create(MOSAICO_NAND_MOUNT_PATH "/muse-character", &store);
+    if (err != ESP_OK) return false;
+    mosaico_character_record_t *record = calloc(1, sizeof(*record));
+    if (!record) { mosaico_character_journal_store_delete(store); return false; }
+    err = mosaico_character_journal_store_load(store, record);
+    bool allowed = err == ESP_ERR_NOT_FOUND;
+    bool restored = false;
+    if (err == ESP_OK) {
+        const esp_partition_t *ui = esp_partition_find_first(
+            ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_ANY, "ui_apps");
+        const bool initial = mosaico_character_record_is_initial(record);
+        const bool admitted = initial ? initial_restore_enabled :
+            mosaico_character_install_admitted(record->job, record->compat_version);
+        const char *expected_compat = initial ?
+            MOSAICO_CHARACTER_INITIAL_COMPAT : mosaico_character_install_compat();
+        mosaico_character_boot_action_t action = ui ? mosaico_character_boot_action(record,
+            admitted, expected_compat,
+            ui->address, ui->size) : MOSAICO_CHARACTER_BOOT_HOLD;
+        allowed = action == MOSAICO_CHARACTER_BOOT_NORMAL;
+        restored = action == MOSAICO_CHARACTER_BOOT_RETURN;
+        if (action == MOSAICO_CHARACTER_BOOT_RESTORE || action == MOSAICO_CHARACTER_BOOT_INSTALL) {
+            factory_character_io_handle_t io = NULL;
+            mosaico_character_transaction_ops_t ops;
+            err = factory_character_io_create(operation_id, &io, &ops);
+            mosaico_character_transaction_result_t result = MOSAICO_CHARACTER_RESULT_HOLD;
+            if (err == ESP_OK) err = mosaico_character_transaction_run(
+                store, &ops, admitted, expected_compat, ui->address, ui->size, &result);
+            if (err == ESP_OK && result == MOSAICO_CHARACTER_RESULT_TRIAL) {
+                err = return_to_trial(store, io, record);
+                factory_character_io_delete(io);
+                free(record); mosaico_character_journal_store_delete(store);
+                return false;
+            }
+            allowed = err == ESP_OK && result == MOSAICO_CHARACTER_RESULT_NORMAL;
+            restored = allowed;
+            if (restored) {
+                err = mosaico_character_journal_store_load(store, record);
+                restored = err == ESP_OK && record->phase == MOSAICO_CHARACTER_ROLLED_BACK;
+                allowed = restored;
+            }
+            factory_character_io_delete(io);
+        }
+        if (!allowed) ESP_LOGW(TAG, "Pending character phase %u; automatic boot held", (unsigned)record->phase);
+    } else if (err != ESP_ERR_NOT_FOUND) {
+        ESP_LOGE(TAG, "Character journal unreadable; automatic boot held: %s", esp_err_to_name(err));
+    }
+    if (restored) {
+        err = return_to_application(store, record);
+        ESP_LOGE(TAG, "Could not return to application: %s", esp_err_to_name(err));
+        free(record); mosaico_character_journal_store_delete(store);
+        return false;
+    }
+    free(record);
+    mosaico_character_journal_store_delete(store);
+    /* Pending/error cases keep the writer reserved until reset. */
+    if (allowed) allowed = factory_system_update_character_finish(operation_id) == ESP_OK;
+    if (allowed) writer_held = false;
+    return allowed;
+}
+
+esp_err_t factory_character_cancel_unwritten(void)
+{
+    if (atomic_flag_test_and_set(&maintenance_busy)) return ESP_ERR_INVALID_STATE;
+    esp_err_t err = ESP_ERR_INVALID_STATE;
+    mosaico_character_journal_store_handle_t store = NULL;
+    mosaico_character_record_t *record = NULL;
+    if (!writer_held) goto done;
+    err = mosaico_nand_store_mount();
+    if (err != ESP_OK) goto done;
+    err = mosaico_character_journal_store_create(MOSAICO_NAND_MOUNT_PATH "/muse-character", &store);
+    if (err != ESP_OK) goto done;
+    record = calloc(1, sizeof(*record));
+    if (!record) { err = ESP_ERR_NO_MEM; goto done; }
+    err = mosaico_character_journal_store_load(store, record);
+    if (err != ESP_OK) goto done;
+    const esp_partition_t *ui = esp_partition_find_first(ESP_PARTITION_TYPE_DATA,
+        ESP_PARTITION_SUBTYPE_ANY, "ui_apps");
+    if (!ui || record->partition_address != ui->address || record->partition_bytes != ui->size) {
+        err = ESP_ERR_INVALID_STATE; goto done;
+    }
+    if (record->phase == MOSAICO_CHARACTER_STAGED || record->phase == MOSAICO_CHARACTER_BACKUP_READY) {
+        record->phase = MOSAICO_CHARACTER_CANCELED; record->sequence++;
+        err = mosaico_character_journal_store_save(store, record);
+        if (err != ESP_OK) goto done;
+        err = mosaico_character_journal_store_load(store, record);
+        if (err != ESP_OK) goto done;
+    }
+    if (record->phase != MOSAICO_CHARACTER_CANCELED) { err = ESP_ERR_NOT_ALLOWED; goto done; }
+    err = factory_system_update_character_finish(held_operation);
+    if (err == ESP_OK) writer_held = false;
+done:
+    free(record); mosaico_character_journal_store_delete(store);
+    atomic_flag_clear(&maintenance_busy);
+    return err;
+}
+
+static void repair_worker(void *repair_journal)
+{
+    mosaico_character_journal_store_handle_t store = NULL;
+    mosaico_character_record_t *record = calloc(1, sizeof(*record));
+    esp_err_t err = record ? mosaico_nand_store_mount() : ESP_ERR_NO_MEM;
+    if (err == ESP_OK) err = mosaico_character_journal_store_create(
+        MOSAICO_NAND_MOUNT_PATH "/muse-character", &store);
+    bool unreadable = false;
+    if (err == ESP_OK) {
+        err = mosaico_character_journal_store_load(store, record);
+        unreadable = err == ESP_ERR_INVALID_STATE;
+    }
+    if (repair_journal && unreadable) {
+        factory_character_io_handle_t initial = NULL;
+        mosaico_character_transaction_ops_t initial_ops;
+        err = factory_character_io_create(held_operation, &initial, &initial_ops);
+        if (err == ESP_OK) err = factory_character_io_prepare_repair(initial, record);
+        factory_character_io_delete(initial);
+        if (err == ESP_OK) {
+            uint32_t id[2]; esp_fill_random(id, sizeof(id));
+            snprintf(record->job, sizeof(record->job), "repair-%08lx%08lx",
+                (unsigned long)id[0], (unsigned long)id[1]);
+            err = mosaico_character_journal_store_repair(store, record);
+            if (err == ESP_OK) err = mosaico_character_journal_store_load(store, record);
+        }
+    } else if (repair_journal && err == ESP_OK) err = ESP_ERR_NOT_ALLOWED;
+    const esp_partition_t *ui = esp_partition_find_first(ESP_PARTITION_TYPE_DATA,
+        ESP_PARTITION_SUBTYPE_ANY, "ui_apps");
+    if (err == ESP_OK && (!ui || record->partition_address != ui->address ||
+        record->partition_bytes != ui->size)) err = ESP_ERR_INVALID_STATE;
+    factory_character_io_handle_t io = NULL;
+    mosaico_character_transaction_ops_t ops;
+    if (err == ESP_OK) err = factory_character_io_create(held_operation, &io, &ops);
+    if (err == ESP_OK && record->phase == MOSAICO_CHARACTER_ROLLBACK_TRIAL) {
+        err = factory_character_io_verify_restored(io, record);
+        if (err == ESP_OK) {
+            record->phase = MOSAICO_CHARACTER_ROLLED_BACK; record->sequence++;
+            err = mosaico_character_journal_store_save(store, record);
+        }
+    } else if (err == ESP_OK) {
+        mosaico_character_boot_action_t action = mosaico_character_boot_action(
+            record, false, NULL, ui->address, ui->size);
+        if (action != MOSAICO_CHARACTER_BOOT_RESTORE && action != MOSAICO_CHARACTER_BOOT_RETURN)
+            err = ESP_ERR_NOT_ALLOWED;
+        else {
+            mosaico_character_transaction_result_t result = MOSAICO_CHARACTER_RESULT_HOLD;
+            err = mosaico_character_transaction_run(store, &ops, false, NULL,
+                ui->address, ui->size, &result);
+            if (err == ESP_OK && result != MOSAICO_CHARACTER_RESULT_NORMAL) err = ESP_ERR_INVALID_STATE;
+        }
+    }
+    factory_character_io_delete(io);
+    if (err == ESP_OK) err = mosaico_character_journal_store_load(store, record);
+    if (err == ESP_OK && record->phase != MOSAICO_CHARACTER_ROLLED_BACK) err = ESP_ERR_INVALID_STATE;
+    if (err == ESP_OK) err = return_to_application(store, record);
+    /* Successful handoff restarts and never returns. Failure retains the
+     * existing record/backups and reports a cached status without NAND scans. */
+    free(record); mosaico_character_journal_store_delete(store);
+    atomic_store(&repair_error, err == ESP_OK ? ESP_FAIL : err);
+    atomic_store(&repair_state, FACTORY_CHARACTER_REPAIR_FAILED);
+    atomic_flag_clear(&maintenance_busy);
+    vTaskDelete(NULL);
+}
+static esp_err_t repair_start(bool journal)
+{
+    if (atomic_flag_test_and_set(&maintenance_busy)) return ESP_ERR_INVALID_STATE;
+    if (!writer_held) { atomic_flag_clear(&maintenance_busy); return ESP_ERR_INVALID_STATE; }
+    atomic_store(&repair_error, ESP_OK);
+    atomic_store(&repair_state, FACTORY_CHARACTER_REPAIR_RUNNING);
+    if (xTaskCreate(repair_worker, "character_repair", 8192, journal ? (void *)1 : NULL, 5, NULL) != pdPASS) {
+        atomic_store(&repair_error, ESP_ERR_NO_MEM);
+        atomic_store(&repair_state, FACTORY_CHARACTER_REPAIR_FAILED);
+        atomic_flag_clear(&maintenance_busy); return ESP_ERR_NO_MEM;
+    }
+    return ESP_OK;
+}
+esp_err_t factory_character_repair_start(void) { return repair_start(false); }
+esp_err_t factory_character_journal_repair_start(void) { return repair_start(true); }
+void factory_character_repair_status(unsigned *state, esp_err_t *error)
+{
+    if (state) *state = atomic_load(&repair_state);
+    if (error) *error = atomic_load(&repair_error);
+}
diff --git a/esp-mosaico-vibe-mode/firmware/vibe-mode/components/app_character/src/factory_character_io.c b/esp-mosaico-vibe-mode/firmware/vibe-mode/components/app_character/src/factory_character_io.c
new file mode 100644
index 0000000..4e32ac9
--- /dev/null
+++ b/esp-mosaico-vibe-mode/firmware/vibe-mode/components/app_character/src/factory_character_io.c
@@ -0,0 +1,241 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "factory_character_io.h"
+#include "factory_system_update.h"
+#include "mosaico_nand_store.h"
+#include "esp_partition.h"
+#include "psa/crypto.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define ROOT MOSAICO_NAND_MOUNT_PATH "/muse-character"
+#define CANDIDATE ROOT "/candidate-ui.bin"
+#define INITIAL_RESTORE ROOT "/factory-ui-restore.bin"
+#define INITIAL_FULL ROOT "/factory-ui.bin"
+#define INITIAL_RECORD ROOT "/factory-ui.record"
+#define BACKUP ROOT "/previous-ui.bin"
+#define BACKUP_TEMP ROOT "/previous-ui.partial"
+enum { CHUNK_BYTES = 4096 };
+struct factory_character_io_t {
+    const esp_partition_t *partition;
+    uint8_t operation_id[ESP_IRIS_SYSTEM_OPERATION_ID_BYTES];
+    uint8_t buffer[CHUNK_BYTES];
+    esp_iris_system_update_component_t component;
+};
+static esp_err_t hash_file(factory_character_io_handle_t h, const char *path,
+    uint32_t bytes, uint8_t hash[32])
+{
+    FILE *f = fopen(path, "rb");
+    if (!f) return ESP_ERR_NOT_FOUND;
+    psa_hash_operation_t op = PSA_HASH_OPERATION_INIT;
+    bool ok = psa_hash_setup(&op, PSA_ALG_SHA_256) == PSA_SUCCESS;
+    uint32_t left = bytes;
+    while (ok && left) {
+        size_t count = left < CHUNK_BYTES ? left : CHUNK_BYTES;
+        ok = fread(h->buffer, 1, count, f) == count &&
+            psa_hash_update(&op, h->buffer, count) == PSA_SUCCESS;
+        left -= count;
+    }
+    size_t written = 0;
+    ok = ok && fgetc(f) == EOF && !ferror(f) &&
+        psa_hash_finish(&op, hash, 32, &written) == PSA_SUCCESS && written == 32;
+    (void)psa_hash_abort(&op);
+    if (fclose(f)) ok = false;
+    return ok ? ESP_OK : ESP_ERR_INVALID_CRC;
+}
+static bool target_matches(factory_character_io_handle_t h, const mosaico_character_record_t *r)
+{
+    return r->partition_address == h->partition->address && r->partition_bytes == h->partition->size;
+}
+static bool repair_source(const mosaico_character_record_t *r)
+{
+    return mosaico_character_record_valid(r) &&
+        !strcmp(r->compat_version, MOSAICO_CHARACTER_REPAIR_COMPAT) &&
+        !strcmp(r->character_version, MOSAICO_CHARACTER_REPAIR_VERSION);
+}
+esp_err_t factory_character_io_prepare_repair(factory_character_io_handle_t h,
+    mosaico_character_record_t *seed)
+{
+    if (!h || !seed) return ESP_ERR_INVALID_ARG;
+    memset(seed, 0, sizeof(*seed));
+    /* Matches the protected backup record, not the untrusted transaction. */
+    struct { uint8_t magic[8]; uint32_t bytes, address; uint8_t sha256[32]; } initial;
+    FILE *f = fopen(INITIAL_RECORD, "rb");
+    if (!f) return ESP_ERR_NOT_FOUND;
+    bool ok = fread(&initial, 1, sizeof(initial), f) == sizeof(initial) &&
+        fgetc(f) == EOF && !ferror(f);
+    if (fclose(f)) ok = false;
+    if (!ok || memcmp(initial.magic, "MCFACT\0\1", 8) ||
+        initial.bytes != h->partition->size || initial.address != h->partition->address)
+        return ESP_ERR_INVALID_STATE;
+    uint8_t digest[32];
+    esp_err_t err = hash_file(h, INITIAL_FULL, initial.bytes, digest);
+    if (err != ESP_OK || memcmp(digest, initial.sha256, sizeof(digest)))
+        return ESP_ERR_INVALID_CRC;
+    f = fopen(INITIAL_FULL, "rb");
+    if (!f) return ESP_ERR_NOT_FOUND;
+    ok = fread(h->buffer, 1, 64, f) == 64;
+    if (fclose(f)) ok = false;
+    uint32_t payload = (uint32_t)h->buffer[12] | (uint32_t)h->buffer[13] << 8 |
+        (uint32_t)h->buffer[14] << 16 | (uint32_t)h->buffer[15] << 24;
+    if (!ok || initial.bytes < 64 || payload > initial.bytes - 64 ||
+        !mosaico_character_image_header_valid(h->buffer, 64, payload + 64))
+        return ESP_ERR_INVALID_RESPONSE;
+    seed->sequence = 1; seed->phase = MOSAICO_CHARACTER_RESTORING;
+    seed->partition_address = initial.address; seed->partition_bytes = initial.bytes;
+    seed->image_bytes = initial.bytes;
+    memcpy(seed->image_sha256, digest, 32); memcpy(seed->backup_sha256, digest, 32);
+    strcpy(seed->compat_version, MOSAICO_CHARACTER_REPAIR_COMPAT);
+    strcpy(seed->character_version, MOSAICO_CHARACTER_REPAIR_VERSION);
+    return ESP_OK;
+}
+static esp_err_t verify_active(factory_character_io_handle_t h,
+    const mosaico_character_record_t *r, uint32_t length, const uint8_t expected[32])
+{
+    if (!h || !r || !target_matches(h, r) || !length || length > h->partition->size)
+        return ESP_ERR_INVALID_ARG;
+    psa_hash_operation_t op = PSA_HASH_OPERATION_INIT;
+    uint8_t digest[32]; size_t written = 0;
+    esp_err_t err = psa_hash_setup(&op, PSA_ALG_SHA_256) == PSA_SUCCESS ? ESP_OK : ESP_FAIL;
+    for (uint32_t offset = 0; err == ESP_OK && offset < length;) {
+        size_t bytes = length - offset;
+        if (bytes > CHUNK_BYTES) bytes = CHUNK_BYTES;
+        err = esp_partition_read(h->partition, offset, h->buffer, bytes);
+        if (err == ESP_OK && psa_hash_update(&op, h->buffer, bytes) != PSA_SUCCESS) err = ESP_FAIL;
+        offset += bytes;
+    }
+    if (err == ESP_OK && (psa_hash_finish(&op, digest, sizeof(digest), &written) != PSA_SUCCESS ||
+        written != sizeof(digest) || memcmp(digest, expected, sizeof(digest)))) err = ESP_ERR_INVALID_CRC;
+    psa_hash_abort(&op);
+    return err;
+}
+esp_err_t factory_character_io_verify_restored(factory_character_io_handle_t h,
+    const mosaico_character_record_t *r)
+{ return r ? verify_active(h, r, r->partition_bytes, r->backup_sha256) : ESP_ERR_INVALID_ARG; }
+esp_err_t factory_character_io_verify_trial(factory_character_io_handle_t h,
+    const mosaico_character_record_t *r)
+{ return r && r->phase == MOSAICO_CHARACTER_TRIAL ?
+    verify_active(h, r, r->image_bytes, r->image_sha256) : ESP_ERR_INVALID_ARG; }
+static esp_err_t verify_candidate(void *context, const mosaico_character_record_t *r)
+{
+    factory_character_io_handle_t h = context;
+    uint8_t digest[32];
+    if (!target_matches(h, r)) return ESP_ERR_INVALID_STATE;
+    const char *path = mosaico_character_record_is_initial(r) ? INITIAL_RESTORE : CANDIDATE;
+    esp_err_t err = hash_file(h, path, r->image_bytes, digest);
+    if (err != ESP_OK || memcmp(digest, r->image_sha256, 32)) return ESP_ERR_INVALID_CRC;
+    /* Native deployable validation is mandatory in the app before it stages
+     * the trusted record. Recovery additionally rejects an invalid outer head. */
+    FILE *f = fopen(path, "rb");
+    if (!f) return ESP_ERR_NOT_FOUND;
+    bool ok = fread(h->buffer, 1, 64, f) == 64;
+    if (fclose(f)) ok = false;
+    ok = ok && mosaico_character_image_header_valid(h->buffer, 64, r->image_bytes);
+    return ok ? ESP_OK : ESP_ERR_INVALID_RESPONSE;
+}
+static esp_err_t backup(void *context, uint8_t digest[32])
+{
+    factory_character_io_handle_t h = context;
+    FILE *f = fopen(BACKUP_TEMP, "wb");
+    if (!f) return ESP_FAIL;
+    psa_hash_operation_t op = PSA_HASH_OPERATION_INIT;
+    bool ok = psa_hash_setup(&op, PSA_ALG_SHA_256) == PSA_SUCCESS;
+    for (uint32_t offset = 0; ok && offset < h->partition->size;) {
+        size_t count = h->partition->size - offset;
+        if (count > CHUNK_BYTES) count = CHUNK_BYTES;
+        ok = esp_partition_read(h->partition, offset, h->buffer, count) == ESP_OK &&
+            fwrite(h->buffer, 1, count, f) == count &&
+            psa_hash_update(&op, h->buffer, count) == PSA_SUCCESS;
+        offset += count;
+    }
+    size_t written = 0;
+    ok = ok && psa_hash_finish(&op, digest, 32, &written) == PSA_SUCCESS && written == 32;
+    (void)psa_hash_abort(&op);
+    if (ok && fflush(f)) ok = false;
+    if (ok && fsync(fileno(f))) ok = false;
+    if (fclose(f)) ok = false;
+    if (!ok) return ESP_FAIL;
+    uint8_t readback[32];
+    esp_err_t err = hash_file(h, BACKUP_TEMP, h->partition->size, readback);
+    if (err != ESP_OK || memcmp(digest, readback, 32)) return ESP_ERR_INVALID_CRC;
+    err = mosaico_nand_store_sync();
+    if (err != ESP_OK) return err;
+    if (rename(BACKUP_TEMP, BACKUP)) return ESP_FAIL;
+    return mosaico_nand_store_sync();
+}
+static esp_err_t verify_backup(void *context, const mosaico_character_record_t *r)
+{
+    factory_character_io_handle_t h = context;
+    if (!target_matches(h, r)) return ESP_ERR_INVALID_STATE;
+    uint8_t digest[32];
+    esp_err_t err = hash_file(h, repair_source(r) ? INITIAL_FULL : BACKUP, r->partition_bytes, digest);
+    return err == ESP_OK && !memcmp(digest, r->backup_sha256, 32) ? ESP_OK : ESP_ERR_INVALID_CRC;
+}
+static esp_err_t write_file(factory_character_io_handle_t h, const char *path,
+    uint32_t bytes, const uint8_t digest[32])
+{
+    uint8_t actual[32];
+    esp_err_t err = hash_file(h, path, bytes, actual);
+    if (err != ESP_OK || memcmp(actual, digest, 32)) return ESP_ERR_INVALID_CRC;
+    FILE *f = fopen(path, "rb");
+    if (!f) return ESP_ERR_NOT_FOUND;
+    err = factory_system_update_character_prepare(h->operation_id, bytes, digest, &h->component);
+    psa_hash_operation_t op = PSA_HASH_OPERATION_INIT;
+    bool hash_ready = psa_hash_setup(&op, PSA_ALG_SHA_256) == PSA_SUCCESS;
+    if (err == ESP_OK && !hash_ready) err = ESP_FAIL;
+    if (err == ESP_OK) err = factory_system_update_source_begin_component(
+        FACTORY_SYSTEM_UPDATE_OWNER_CHARACTER, &h->component);
+    for (uint32_t offset = 0; err == ESP_OK && offset < bytes;) {
+        size_t count = bytes - offset;
+        if (count > CHUNK_BYTES) count = CHUNK_BYTES;
+        if (fread(h->buffer, 1, count, f) != count ||
+            psa_hash_update(&op, h->buffer, count) != PSA_SUCCESS) { err = ESP_FAIL; break; }
+        err = factory_system_update_source_write_component(
+            FACTORY_SYSTEM_UPDATE_OWNER_CHARACTER, &h->component, offset, h->buffer, count);
+        offset += count;
+    }
+    size_t written = 0;
+    if (err == ESP_OK && (fgetc(f) != EOF || ferror(f) ||
+        psa_hash_finish(&op, actual, 32, &written) != PSA_SUCCESS || written != 32)) err = ESP_FAIL;
+    (void)psa_hash_abort(&op);
+    if (fclose(f) && err == ESP_OK) err = ESP_FAIL;
+    if (err == ESP_OK) err = factory_system_update_source_end_component(
+        FACTORY_SYSTEM_UPDATE_OWNER_CHARACTER, &h->component, actual);
+    return err;
+}
+static esp_err_t write_candidate(void *context, const mosaico_character_record_t *r)
+{
+    if (r->phase != MOSAICO_CHARACTER_WRITING) return ESP_ERR_INVALID_STATE;
+    return write_file(context, mosaico_character_record_is_initial(r) ? INITIAL_RESTORE : CANDIDATE,
+        r->image_bytes, r->image_sha256);
+}
+static esp_err_t restore_backup(void *context, const mosaico_character_record_t *r)
+{
+    if (r->phase != MOSAICO_CHARACTER_RESTORING) return ESP_ERR_INVALID_STATE;
+    return write_file(context, repair_source(r) ? INITIAL_FULL : BACKUP,
+        r->partition_bytes, r->backup_sha256);
+}
+esp_err_t factory_character_io_create(const uint8_t operation_id[16],
+    factory_character_io_handle_t *out, mosaico_character_transaction_ops_t *ops)
+{
+    if (!operation_id || !out || !ops) return ESP_ERR_INVALID_ARG;
+    *out = NULL;
+    const esp_partition_t *ui = esp_partition_find_first(
+        ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_ANY, "ui_apps");
+    if (!ui || ui->size > 0x300000U || ui->address < 0x200000U) return ESP_ERR_INVALID_SIZE;
+    factory_character_io_handle_t h = calloc(1, sizeof(*h));
+    if (!h) return ESP_ERR_NO_MEM;
+    if (psa_crypto_init() != PSA_SUCCESS) { free(h); return ESP_FAIL; }
+    h->partition = ui;
+    memcpy(h->operation_id, operation_id, sizeof(h->operation_id));
+    *ops = (mosaico_character_transaction_ops_t){ .context = h,
+        .verify_candidate = verify_candidate, .backup = backup, .verify_backup = verify_backup,
+        .write_candidate = write_candidate, .restore_backup = restore_backup };
+    *out = h;
+    return ESP_OK;
+}
+void factory_character_io_delete(factory_character_io_handle_t h)
+{
+    free(h);
+}
