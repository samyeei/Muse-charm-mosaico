@@ -3,6 +3,7 @@ from __future__ import annotations
 
 import copy
 import plistlib
+import re
 import subprocess
 import sys
 from typing import Any
@@ -95,6 +96,8 @@ def _mac_interfaces() -> dict[str, dict[str, Any]]:
 
 def serial_ports() -> list[Any]:
     ports = list(list_ports.comports())
+    if sys.platform == "win32":
+        return [_windows_port(port) for port in ports]
     if sys.platform != "darwin":
         return ports
     descriptors = _mac_interfaces() if ports else {}
@@ -119,6 +122,18 @@ def serial_ports() -> list[Any]:
     return list(result.values())
 
 
+def _windows_port(original: Any) -> Any:
+    """pySerial exposes Windows MI numbers in location, but no interface name."""
+    if (original.vid, original.pid) != (0x303A, 0x4002):
+        return original
+    port = copy.copy(original)
+    match = re.search(r":(?:x|[0-9]+)\.([0-9]+)$", getattr(port, "location", None) or "")
+    number = int(match.group(1)) if match else None
+    port.interface = _IRIS_INTERFACES.get(number, "")
+    port.iris_link_role = {0: "control", 2: "data"}.get(number, "unknown")
+    return port
+
+
 def link_role(port: Any) -> str:
     return getattr(port, "iris_link_role", None) or (
         "data" if getattr(port, "interface", None) == "ESP-Iris 0.2 data" else "control")
diff --git a/ESP-Iris/components/esp_iris/tools/tests/test_windows_usb.py b/ESP-Iris/components/esp_iris/tools/tests/test_windows_usb.py
