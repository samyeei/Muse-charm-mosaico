diff --git a/esp-mosaico-vibe-mode/tests/firmware/character_powercut/README.md b/esp-mosaico-vibe-mode/tests/firmware/character_powercut/README.md
new file mode 100644
index 0000000..445cbff
--- /dev/null
+++ b/esp-mosaico-vibe-mode/tests/firmware/character_powercut/README.md
@@ -0,0 +1,20 @@
+# Character write-time power-cut fixture
+
+Build Recovery with the explicit CMake option `MOSAICO_CHARACTER_POWERCUT_FIXTURE=ON`.
+It replaces only the character I/O translation unit with a wrapper around the
+production implementation. Normal builds default to OFF and exclude this file.
+
+Only a validated local initial restore with job `powercut-initial-20261006`
+pauses after the first successful NOR chunk write. The production transaction
+has already verified its full previous-resource backup and committed WRITING.
+Other jobs and every rollback use the production path without a pause.
+
+After the `POWERCUT_READY` log, physically remove all power, including battery
+power, and restore power. Do not issue a maintenance retry. Verify automatic
+Recovery rollback, full old-image hash, application first frame, normal mode,
+same Device ID/new Boot ID, and user-visible character/conversation behavior.
+Restore the reviewed non-fixture Recovery after acceptance. Never publish the
+fixture bundle or mark host-process exit tests as physical power-cut evidence.
+
+This fixture adds no RPC, bypasses no candidate/image admission check, does not
+change partition layout and does not replace the protected initial backup.
diff --git a/esp-mosaico-vibe-mode/tests/firmware/character_powercut/character_powercut_io.c b/esp-mosaico-vibe-mode/tests/firmware/character_powercut/character_powercut_io.c
new file mode 100644
index 0000000..dd48f86
--- /dev/null
+++ b/esp-mosaico-vibe-mode/tests/firmware/character_powercut/character_powercut_io.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: Apache-2.0
+/* Test-only replacement translation unit. The exclusive Recovery transaction
+ * worker is the sole owner of armed. Production builds never compile this file.
+ * Only the exact local initial-restore job below pauses; rollback never pauses. */
+#include "factory_character_io.h"
+#include "factory_system_update.h"
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include <string.h>
+
+static bool armed;
+static esp_err_t checkpoint_write(factory_system_update_owner_t owner,
+    const esp_iris_system_update_component_t *component, uint32_t offset,
+    const uint8_t *data, size_t size)
+{
+    esp_err_t err = factory_system_update_source_write_component(owner, component, offset, data, size);
+    if (err == ESP_OK && armed && offset == 0 && size) {
+        ESP_LOGW("character_powercut", "POWERCUT_READY: first chunk written; backup and WRITING durable; switch power OFF then ON");
+        for (;;) vTaskDelay(pdMS_TO_TICKS(1000));
+    }
+    return err;
+}
+
+#define factory_system_update_source_write_component checkpoint_write
+#define factory_character_io_create fixture_base_create
+#include "../../../firmware/recovery/main/factory_character_io.c"
+#undef factory_system_update_source_write_component
+#undef factory_character_io_create
+
+static esp_err_t test_write_candidate(void *context, const mosaico_character_record_t *record)
+{
+    armed = mosaico_character_record_is_initial(record) &&
+        !strcmp(record->job, "powercut-initial-20261006");
+    esp_err_t err = write_candidate(context, record);
+    armed = false;
+    return err;
+}
+
+esp_err_t factory_character_io_create(const uint8_t operation_id[16],
+    factory_character_io_handle_t *out, mosaico_character_transaction_ops_t *ops)
+{
+    esp_err_t err = fixture_base_create(operation_id, out, ops);
+    if (err == ESP_OK) ops->write_candidate = test_write_candidate;
+    return err;
+}
