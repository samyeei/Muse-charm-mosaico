+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "esp_err.h"
+#include "mosaico_character_journal.h"
+
+typedef struct mosaico_character_journal_store_t *mosaico_character_journal_store_handle_t;
+/* Caller mounts NAND first. Directory is trusted local policy, not a package
+ * field. Single coordinator owns this handle and all calls. No auto-format,
+ * deletion of committed records, or filesystem capacity scans. */
+esp_err_t mosaico_character_journal_store_create(const char *directory,
+    mosaico_character_journal_store_handle_t *out);
+void mosaico_character_journal_store_delete(mosaico_character_journal_store_handle_t handle);
+/* NOT_FOUND means both committed slots absent. Any corrupt/unreadable slot
+ * fails closed, even if the other is valid: that slot could record WRITING. */
+esp_err_t mosaico_character_journal_store_load(mosaico_character_journal_store_handle_t handle,
+    mosaico_character_record_t *out);
+/* Flush temp -> read-back -> NAND sync -> rename inactive slot -> NAND sync.
+ * On failure the caller MUST reload; no NOR mutation is allowed based on a
+ * save that failed. The renamed record may already be durable. */
+esp_err_t mosaico_character_journal_store_save(mosaico_character_journal_store_handle_t handle,
+    const mosaico_character_record_t *record);
+/* Explicit trusted Recovery repair only. Caller verifies the complete protected
+ * initial backup and live layout before supplying a RESTORING sequence-1 seed
+ * with reserved REPAIR tags. Preserves original slots, archives any selector,
+ * publishes a unique immutable seed then a durable selector. Never formats,
+ * erases NOR, or clears damaged history. Failed publication MUST be reloaded.
+ * All future consumers of this store follow the selected repair history. */
+esp_err_t mosaico_character_journal_store_repair(mosaico_character_journal_store_handle_t handle,
+    const mosaico_character_record_t *seed);
diff --git a/esp-mosaico-vibe-mode/components/esp_mosaico_character_journal/include/mosaico_character_transaction.h b/esp-mosaico-vibe-mode/components/esp_mosaico_character_journal/include/mosaico_character_transaction.h
