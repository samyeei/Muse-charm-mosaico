+typedef int esp_err_t;
+#define ESP_OK 0
+#define ESP_FAIL -1
+#define ESP_ERR_NO_MEM 1
+#define ESP_ERR_INVALID_ARG 2
+#define ESP_ERR_INVALID_SIZE 3
+#define ESP_ERR_INVALID_STATE 4
+#define ESP_ERR_NOT_FOUND 5
+""", encoding="utf-8")
+    (tmp_path / "mosaico_nand_store.h").write_text(
+        '#include "esp_err.h"\nesp_err_t mosaico_nand_store_sync(void);\n', encoding="utf-8")
