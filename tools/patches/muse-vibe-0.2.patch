+{assert(id && n==4096 && hash && c);++prepares;return 0;}
+esp_err_t factory_system_update_source_begin_component(int o,const esp_iris_system_update_component_t *c)
+{assert(o==4 && c);++begins;return 0;}
+esp_err_t factory_system_update_source_write_component(int o,const esp_iris_system_update_component_t *c,uint32_t off,const uint8_t *b,size_t n)
+{assert(o==4 && c && off+n<=4096);++writes;memcpy(written+off,b,n);return 0;}
+esp_err_t factory_system_update_source_end_component(int o,const esp_iris_system_update_component_t *c,const uint8_t *hash)
+{assert(o==4 && c && hash);return 0;}
+static void file_bytes(const char *path,const void *b,size_t n)
+{FILE *f=fopen(path,"wb");assert(f);assert(fwrite(b,1,n,f)==n);assert(!fclose(f));}
+static void publish_initial(void)
+{
+ struct {uint8_t magic[8];uint32_t bytes,address;uint8_t hash[32];} record;
+ memcpy(record.magic,"MCFACT\0\1",8);record.bytes=4096;record.address=partition.address;
+ uint32_t op;size_t n;psa_hash_setup(&op,1);psa_hash_update(&op,original,4096);
+ psa_hash_finish(&op,record.hash,32,&n);
+ file_bytes(INITIAL_FULL,original,4096);file_bytes(INITIAL_RECORD,&record,sizeof(record));
+}
+int main(int argc,char **argv)
