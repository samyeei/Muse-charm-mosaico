+++ b/esp-mosaico-vibe-mode/components/esp_mosaico_character_journal/include/mosaico_character_transaction.h
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "mosaico_character_journal_store.h"
+
+/* Recovery coordinator owns the shared NOR writer for this entire call,
+ * including backup and rollback. Callbacks are synchronous, borrowed context.
+ * Backups must cover the complete partition; successful write callbacks MUST
+ * include NOR read-back SHA verification. This engine never selects a boot
+ * partition; TRIAL is returned only after its record is durably committed. */
+typedef struct {
+    void *context;
+    esp_err_t (*verify_candidate)(void *, const mosaico_character_record_t *);
+    esp_err_t (*backup)(void *, uint8_t sha256[32]);
+    esp_err_t (*verify_backup)(void *, const mosaico_character_record_t *);
+    esp_err_t (*write_candidate)(void *, const mosaico_character_record_t *);
+    esp_err_t (*restore_backup)(void *, const mosaico_character_record_t *);
+} mosaico_character_transaction_ops_t;
+
+typedef enum {
+    MOSAICO_CHARACTER_RESULT_HOLD,
+    MOSAICO_CHARACTER_RESULT_NORMAL,
+    MOSAICO_CHARACTER_RESULT_TRIAL,
+} mosaico_character_transaction_result_t;
+
+esp_err_t mosaico_character_transaction_run(
+    mosaico_character_journal_store_handle_t store,
+    const mosaico_character_transaction_ops_t *ops,
+    bool frozen_compat, const char *compat_version,
+    uint32_t partition_address, uint32_t partition_bytes,
+    mosaico_character_transaction_result_t *result);
